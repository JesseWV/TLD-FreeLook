<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <RootNamespace>FreeLook</RootNamespace>
    <AssemblyName>FreeLook</AssemblyName>
    <LangVersion>latest</LangVersion>
    <!-- Version feeds AssemblyInformationalVersion, which the SDK suffixes with the HEAD commit.
         Without it the build line logs the SDK default of "1.0.0+<sha>" while the MelonLoader banner
         says the real version, and a player pasting their log shows two different numbers for one
         mod. AssemblyVersion and FileVersion are DERIVED from this and are deliberately not set:
         measured 2026-09-05, the SDK produces 1.5.0.0 for both from Version alone, so setting them
         only adds two more places for a release to disagree with itself. -->
    <Version>1.5.0</Version>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <!-- Il2Cpp reference assemblies + ModSettings via NuGet, so the project builds without a local
       game install. Same pins as the other 2.55-era mods in this workspace. -->
  <ItemGroup>
    <PackageReference Include="Waltz.Modding.TLD.Il2CppAssemblies.Windows" Version="2.52.0" />
    <PackageReference Include="STBlade.Modding.TLD.ModSettings" Version="1.9.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System" />
  </ItemGroup>

</Project>
